    "This activity has incomplete subtasks. Would you like to mark the activity and all its subtasks as done?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذه المهمة تحتوي على مهام فرعية غير مكتملة. هل ترغب في اعتبار النشاط وجميع مهامه الفرعية مكتملة؟"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Aktivität hat unvollständige Unteraufgaben. Möchtest du die Aktivität und alle ihre Unteraufgaben als erledigt markieren?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This activity has incomplete subtasks. Would you like to mark the activity and all its subtasks as done?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta actividad tiene subtareas incompletas. ¿Te gustaría marcar la actividad y todas sus subtareas como hechas?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette activité comporte des sous-tâches incomplètes. Souhaitez-vous marquer l’activité et toutes ses sous-tâches comme terminées ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa attività ha sottoattività incomplete. Vuoi contrassegnare l'attività e tutte le sue sottoattività come completate?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアクティビティには未完了のサブタスクがあります。すべて完了としてマークしますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 활동에는 완료되지 않은 하위 작업이 있습니다. 활동과 모든 하위 작업을 완료로 표시하시겠습니까?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta aktywność ma nieskończone zadania. Czy chcesz oznaczyć aktywność i wszystkie jej zadania jako wykonane?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta atividade possui subtarefas incompletas. Deseja marcar a atividade e todas as subtarefas como concluídas?"
          }
        }
      }
    },
    "This is the last task for this activity. Would you like to mark the activity as complete?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذه آخر مهمة في هذا النشاط. هل ترغب في اعتبار النشاط مكتملًا؟"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies ist die letzte Aufgabe für diese Aktivität. Möchtest du die Aktivität als abgeschlossen markieren?"
          }
        },
        "en" : {
