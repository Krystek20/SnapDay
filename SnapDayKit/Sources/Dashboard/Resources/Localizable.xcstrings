    "%lld of %lld planned activities complete" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld of %lld planned activities complete"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اكتمل %1$lld من %2$lld من الأنشطة المخططة"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld von %2$lld geplanten Aktivitäten erledigt"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld de %2$lld actividades planificadas completadas"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld activités planifiées sur %2$lld terminées"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld attività pianificate su %2$lld completate"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$lld件中%1$lld件の予定アクティビティが完了"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계획된 활동 %2$lld개 중 %1$lld개 완료"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukończono %1$lld z %2$lld zaplanowanych aktywności"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld de %2$lld atividades planejadas concluídas"
          }
        }
      }
    },
    "🎉 Great job! Now, take a rest and enjoy the rest of your day with a smile! 🎉" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🎉 عمل رائع! الآن، خذ قسطًا من الراحة واستمتع ببقية يومك بابتسامة! 🎉"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🎉 Gute Arbeit! Jetzt ruhe dich aus und genieße den Rest deines Tages mit einem Lächeln! 🎉"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🎉 Great job! Now, take a rest and enjoy the rest of your day with a smile! 🎉"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🎉 ¡Gran trabajo! Ahora, descansa y disfruta el resto de tu día con una sonrisa. 🎉"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🎉 Super travail ! Maintenant, repose-toi et profite du reste de ta journée avec le sourire ! 🎉"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🎉 Ottimo lavoro! Ora riposati e goditi il resto della giornata con un sorriso! 🎉"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🎉 素晴らしい仕事です！今は休憩して、笑顔で一日を楽しんでください！ 🎉"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🎉 잘했어요! 이제 휴식을 취하고 웃으며 남은 하루를 즐기세요! 🎉"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🎉 Świetna robota! Teraz odpocznij i ciesz się resztą dnia z uśmiechem! 🎉"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🎉 Ótimo trabalho! Agora, descanse e aproveite o resto do seu dia com um sorriso! 🎉"
          }
        }
      }
    },
    "A blank canvas awaits your plans or spontaneous joys." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنتظرك لوحة فارغة تخطط لأفكارك أو أفراحك العفوية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine leere Leinwand erwartet deine Pläne oder spontanen Freuden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A blank canvas awaits your plans or spontaneous joys."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un lienzo en blanco espera tus planes o alegrías espontáneas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une toile blanche attend tes projets ou tes joies spontanées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una tela bianca aspetta i tuoi piani o le tue gioie spontanee."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "真っ白なキャンバスが、あなたの計画や思いがけない喜びを待っています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "빈 캔버스가 당신의 계획이나 즉흥적인 기쁨을 기다리고 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pusta karta czeka na Twoje plany lub spontaniczne radości."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma tela em branco espera pelos seus planos ou alegrias espontâneas."
          }
        }
      }
    },
