    "Plan activities must be kept to preserve their schedules and progress." : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "يجب الاحتفاظ بأنشطة الخطة للحفاظ على جداولها وتقدمها." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Planaktivitäten müssen beibehalten werden, damit Zeitpläne und Fortschritt erhalten bleiben." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Plan activities must be kept to preserve their schedules and progress." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Las actividades del plan deben conservarse para mantener sus horarios y progreso." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Les activités du plan doivent être conservées afin de préserver leur programmation et leur progression." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Le attività del piano devono essere mantenute per conservarne la programmazione e i progressi." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "スケジュールと進捗を保持するため、プランのアクティビティは削除できません。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "플랜의 일정과 진행 상황을 유지하려면 플랜 활동을 보존해야 합니다." } },
        "pl" : { "stringUnit" : { "state" : "translated", "value" : "Aktywności planu muszą zostać zachowane, aby utrzymać harmonogram i postęp." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "As atividades do plano precisam ser mantidas para preservar os agendamentos e o progresso." } }
      }
    },
