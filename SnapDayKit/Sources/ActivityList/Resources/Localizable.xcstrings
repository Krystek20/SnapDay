    "Easily save your favorite activities for quick access in the future." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احفظ أنشطتك المفضلة للوصول السريع إليها لاحقًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speichern Sie Ihre Lieblingsaktivitäten ganz einfach für den schnellen Zugriff in der Zukunft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Easily save your favorite activities for quick access in the future."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda fácilmente tus actividades favoritas para un acceso rápido en el futuro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez facilement vos activités préférées pour y accéder rapidement plus tard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva facilmente le tue attività preferite per accedervi rapidamente in futuro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "よく使うアクティビティを保存しておくと、後ですぐにアクセスできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자주 사용하는 활동을 저장해두면 나중에 빠르게 이용할 수 있어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Łatwo zapisz swoje ulubione aktywności, aby mieć do nich szybki dostęp w przyszłości."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salve suas atividades favoritas para acesso rápido no futuro."
          }
        }
      }
