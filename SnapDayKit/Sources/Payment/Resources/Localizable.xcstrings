    "No payment today. After 14 days, %@ per year. Renews automatically until canceled." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تدفع شيئًا اليوم. بعد 14 يومًا، %@ سنويًا. يتجدد تلقائيًا حتى يتم الإلغاء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heute zahlst du nichts. Nach 14 Tagen %@ pro Jahr. Verlängert sich automatisch, bis du kündigst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoy no pagas nada. Después de 14 días, %@ al año. Se renueva automáticamente hasta que canceles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun paiement aujourd’hui. Après 14 jours, %@ par an. Renouvellement automatique jusqu’à résiliation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oggi non paghi nulla. Dopo 14 giorni, %@ all’anno. Si rinnova automaticamente fino all’annullamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本日のお支払いはありません。14日後から年額%@。キャンセルするまで自動更新されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘은 결제되지 않습니다. 14일 후부터 연간 %@입니다. 취소할 때까지 자동으로 갱신됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dziś nic nie płacisz. Po 14 dniach %@ rocznie. Odnawia się automatycznie do czasu anulowania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada a pagar hoje. Após 14 dias, %@ por ano. Renovação automática até o cancelamento."
          }
        }
      }
    },
