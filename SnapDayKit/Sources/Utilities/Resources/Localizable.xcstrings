{
  "sourceLanguage" : "en",
  "strings" : {
    "Hey there! Just a gentle nudge to tackle your planned activity today. You’ve got this!" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مرحبًا! مجرد تذكير لطيف لبدء نشاطك المخطط له اليوم. أنت تستطيع القيام بذلك!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hey! Eine kleine Erinnerung, um deine geplante Aktivität heute anzugehen. Du schaffst das!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hey there! Just a gentle nudge to tackle your planned activity today. You’ve got this!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Hola! Un suave recordatorio para que completes tu actividad planificada de hoy. ¡Tú puedes!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salut ! Juste un petit coup de pouce pour aborder votre activité planifiée aujourd'hui. Vous pouvez le faire !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciao! Solo un piccolo incoraggiamento per affrontare la tua attività pianificata oggi. Ce la puoi fare!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "こんにちは！今日は予定しているアクティビティに取り組むよう、優しくお知らせします。あなたはできます！"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "안녕하세요! 오늘 계획된 활동을 시작하도록 부드럽게 마무리하세요. 당신은 할 수 있습니다!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hej! Małe przypomnienie, aby zająć się zaplanowaną aktywnością na dziś. Dasz radę!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olá! Apenas um lembrete gentil para lidar com sua atividade planejada hoje. Você consegue!"
          }
        }
      }
    },
