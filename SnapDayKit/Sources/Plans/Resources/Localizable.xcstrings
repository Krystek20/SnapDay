    "Build a weekly plan from your saved activities. SnapDay will add them on the days you choose." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنشئ خطة أسبوعية من أنشطتك المحفوظة. سيضيفها SnapDay في الأيام التي تختارها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstelle aus deinen gespeicherten Aktivitäten einen Wochenplan. SnapDay fügt sie an den ausgewählten Tagen hinzu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Build a weekly plan from your saved activities. SnapDay will add them on the days you choose."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea un plan semanal con tus actividades guardadas. SnapDay las añadirá los días que elijas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créez un plan hebdomadaire à partir de vos activités enregistrées. SnapDay les ajoutera aux jours choisis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea un piano settimanale dalle attività salvate. SnapDay le aggiungerà nei giorni scelti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存済みのアクティビティから週間プランを作成します。SnapDayが選択した曜日に追加します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장된 활동으로 주간 플랜을 만드세요. SnapDay가 선택한 요일에 활동을 추가합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utwórz tygodniowy plan z zapisanych aktywności. SnapDay doda je w wybrane dni."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crie um plano semanal com suas atividades salvas. O SnapDay vai adicioná-las nos dias escolhidos."
