    "Changing the start date keeps the selected duration. Changing the end date sets a custom duration." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يؤدي تغيير تاريخ البدء إلى الاحتفاظ بالمدة المحددة. ويؤدي تغيير تاريخ الانتهاء إلى تعيين مدة مخصصة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Ändern des Startdatums bleibt die gewählte Dauer erhalten. Ein neues Enddatum legt eine eigene Dauer fest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changing the start date keeps the selected duration. Changing the end date sets a custom duration."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al cambiar la fecha de inicio se mantiene la duración elegida. Al cambiar la fecha de fin se establece una duración personalizada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifier la date de début conserve la durée choisie. Modifier la date de fin définit une durée personnalisée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambiando la data di inizio mantieni la durata scelta. Cambiando la data di fine imposti una durata personalizzata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開始日を変更しても選択した期間は維持されます。終了日を変更するとカスタム期間になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시작 날짜를 변경해도 선택한 기간은 유지됩니다. 종료 날짜를 변경하면 사용자 지정 기간이 설정됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmiana daty rozpoczęcia zachowuje wybrany czas trwania. Zmiana daty zakończenia ustawia własny czas trwania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alterar a data de início mantém a duração escolhida. Alterar a data de término define uma duração personalizada."
          }
        }
      }
    },
