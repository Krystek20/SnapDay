    "It no longer generates activities. Its previous schedule and progress are kept for reference." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم تعد هذه الخطة تنشئ أنشطة. تم الاحتفاظ بجدولها السابق وتقدمها للرجوع إليهما."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Plan erstellt keine Aktivitäten mehr. Der bisherige Zeitplan und Fortschritt bleiben als Referenz erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It no longer generates activities. Its previous schedule and progress are kept for reference."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este plan ya no genera actividades. Su calendario y progreso anteriores se conservan como referencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce plan ne génère plus d’activités. Son ancien programme et sa progression sont conservés à titre de référence."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo piano non genera più attività. Il programma e i progressi precedenti restano disponibili come riferimento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプランからアクティビティは作成されません。以前のスケジュールと進捗は参照用に保存されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 플랜은 더 이상 활동을 생성하지 않습니다. 이전 일정과 진행 상황은 참고용으로 보관됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten plan nie tworzy już aktywności. Poprzedni harmonogram i postępy zachowano do wglądu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este plano não gera mais atividades. O cronograma e o progresso anteriores são mantidos para consulta."
          }
        }
      }
    },
    "Its date range has ended or its schedule is empty. Create a similar plan with a new schedule." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتهى نطاق تاريخها أو أن جدولها فارغ. أنشئ خطة مشابهة بجدول جديد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Zeitraum ist abgelaufen oder der Zeitplan ist leer. Erstelle einen ähnlichen Plan mit neuem Zeitplan."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Its date range has ended or its schedule is empty. Create a similar plan with a new schedule."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su intervalo de fechas ha terminado o su calendario está vacío. Crea un plan similar con un calendario nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa période est terminée ou son programme est vide. Créez un plan similaire avec un nouveau programme."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'intervallo di date è terminato o il programma è vuoto. Crea un piano simile con un nuovo programma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "期間が終了したか、スケジュールが空です。新しいスケジュールで同様のプランを作成してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "날짜 범위가 끝났거나 일정이 비어 있습니다. 새 일정으로 비슷한 플랜을 만드세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zakres dat dobiegł końca lub harmonogram jest pusty. Utwórz podobny plan z nowym harmonogramem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O intervalo de datas terminou ou o cronograma está vazio. Crie um plano semelhante com um novo cronograma."
          }
        }
      }
    },
