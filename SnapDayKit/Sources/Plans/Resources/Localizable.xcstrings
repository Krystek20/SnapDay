    "Selected days will copy the source day's activities. You'll confirm before replacing existing activities." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستنسخ الأيام المحددة أنشطة يوم المصدر. ستؤكد قبل استبدال الأنشطة الحالية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die ausgewählten Tage übernehmen die Aktivitäten des Quelltags. Vorhandene Aktivitäten werden erst nach Bestätigung ersetzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selected days will copy the source day's activities. You'll confirm before replacing existing activities."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los días seleccionados copiarán las actividades del día de origen. Confirmarás antes de sustituir las actividades existentes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les jours sélectionnés copieront les activités du jour source. Vous confirmerez avant de remplacer les activités existantes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I giorni selezionati copieranno le attività del giorno di origine. Confermerai prima di sostituire le attività esistenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択した曜日にコピー元のアクティビティがコピーされます。既存のアクティビティを置き換える前に確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 요일에 원본 요일의 활동이 복사됩니다. 기존 활동을 교체하기 전에 확인할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do wybranych dni zostaną skopiowane aktywności z dnia źródłowego. Przed zastąpieniem istniejących aktywności pojawi się prośba o potwierdzenie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dias selecionados copiarão as atividades do dia de origem. Você confirmará antes de substituir atividades existentes."
          }
        }
      }
    },
