    "This plan has nothing scheduled today. Your daily list may still include other activities." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تحتوي هذه الخطة على أي شيء مجدول اليوم. قد تظل قائمتك اليومية تتضمن أنشطة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für diesen Plan ist heute nichts vorgesehen. Deine Tagesliste kann trotzdem andere Aktivitäten enthalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This plan has nothing scheduled today. Your daily list may still include other activities."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este plan no tiene nada programado para hoy. Tu lista diaria puede incluir otras actividades."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce plan ne prévoit rien aujourd’hui. Votre liste quotidienne peut toutefois contenir d’autres activités."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo piano non prevede nulla per oggi. L'elenco giornaliero può comunque includere altre attività."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプランには今日の予定がありません。デイリーリストにはほかのアクティビティが含まれる場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 플랜에는 오늘 예정된 항목이 없습니다. 일일 목록에는 다른 활동이 포함될 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W tym planie nie ma dziś nic zaplanowanego. Lista dnia może nadal zawierać inne aktywności."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este plano não tem nada agendado para hoje. Sua lista diária ainda pode incluir outras atividades."
          }
        }
      }
    },
