    "The plan and its progress will be deleted. Completed activities will remain in your history." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم حذف الخطة وتقدمها. ستبقى الأنشطة المكتملة في سجلك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Plan und sein Fortschritt werden gelöscht. Abgeschlossene Aktivitäten bleiben in deinem Verlauf erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The plan and its progress will be deleted. Completed activities will remain in your history."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El plan y su progreso se eliminarán. Las actividades completadas permanecerán en tu historial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le plan et sa progression seront supprimés. Les activités terminées resteront dans votre historique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il piano e i suoi progressi verranno eliminati. Le attività completate resteranno nella cronologia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プランと進捗は削除されます。完了したアクティビティは履歴に残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "플랜과 진행 상황이 삭제됩니다. 완료한 활동은 기록에 남습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plan i jego postęp zostaną usunięte. Ukończone aktywności pozostaną w historii."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O plano e seu progresso serão excluídos. As atividades concluídas permanecerão no seu histórico."
          }
        }
      }
    },
    "The selected date range no longer includes these days. Their scheduled activities will be removed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يعد نطاق التاريخ المحدد يتضمن هذه الأيام. ستتم إزالة أنشطتها المجدولة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der ausgewählte Zeitraum enthält diese Tage nicht mehr. Die dafür geplanten Aktivitäten werden entfernt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The selected date range no longer includes these days. Their scheduled activities will be removed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El intervalo de fechas seleccionado ya no incluye estos días. Se eliminarán sus actividades programadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La période sélectionnée n’inclut plus ces jours. Leurs activités planifiées seront supprimées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'intervallo di date selezionato non include più questi giorni. Le attività programmate verranno rimosse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択した期間にこれらの日付が含まれなくなりました。予定されているアクティビティは削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 날짜 범위에 해당 날짜가 더 이상 포함되지 않습니다. 예정된 활동이 제거됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybrany zakres dat nie obejmuje już tych dni. Zaplanowane aktywności zostaną usunięte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O intervalo de datas selecionado não inclui mais esses dias. As atividades agendadas serão removidas."
          }
        }
      }
    },
    "This plan can't be restored" : {
