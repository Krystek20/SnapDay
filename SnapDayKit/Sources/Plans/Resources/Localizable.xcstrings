    "Add an activity to at least one available day." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف نشاطًا إلى يوم متاح واحد على الأقل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge mindestens einem verfügbaren Tag eine Aktivität hinzu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add an activity to at least one available day."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade una actividad al menos a un día disponible."
