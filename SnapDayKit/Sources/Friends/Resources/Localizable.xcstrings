    "Invite friends to collaborate on your boards and share activities." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ادع أصدقاء للتعاون على لوحاتك ومشاركة الأنشطة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lade Freunde ein, um an deinen Boards zusammenzuarbeiten und Aktivitäten zu teilen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invita amigos a colaborar en tus tableros y compartir actividades."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invitez des amis à collaborer sur vos tableaux et partager des activités."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invita amici a collaborare sui tuoi tabelloni e condividere attività."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "友達をボードでコラボレーションし、アクティビティを共有するよう招待します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "친구들을 보드에서 협업하고 활동을 공유하도록 초대하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaproś znajomych do współpracy nad swoimi tablicami i dzielenia się aktywnościami."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Convide amigos para colaborar em seus quadros e compartilhar atividades."
          }
        }
      }
    },
