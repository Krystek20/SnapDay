    "Hang tight! We're generating your private collaboration link. Once it's ready, send it to your invitee to get started." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتظر! نحن ننشئ رابط التعاون الخاص بك. بمجرد أن يكون جاهزًا، أرسله إلى المدعو للبدء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bleib dran! Wir generieren deinen privaten Kollaborationslink. Sobald er fertig ist, sende ihn an deinen Eingeladenen, um loszulegen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Espera! Estamos generando tu enlace de colaboración privado. Una vez que esté listo, envíalo a tu invitado para comenzar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attendez ! Nous générons votre lien de collaboration privé. Une fois prêt, envoyez-le à votre invité pour commencer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aspetta! Stiamo generando il tuo link di collaborazione privato. Una volta pronto, invialo al tuo invitato per iniziare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お待ちください！プライベートコラボレーションリンクを生成しています。準備ができたら、招待者に送信して開始してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잠깐만요! 개인 협업 링크를 생성하고 있습니다. 준비되면 초대자에게 보내서 시작하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poczekaj! Generujemy twój prywatny link do współpracy. Gdy będzie gotowy, wyślij go zaproszonej osobie, aby rozpocząć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aguarde! Estamos gerando seu link de colaboração privado. Quando estiver pronto, envie-o para seu convidado para começar."
          }
        }
      }
    },
