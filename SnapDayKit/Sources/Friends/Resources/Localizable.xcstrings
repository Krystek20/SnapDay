    "They accepted your board, but haven't shared theirs yet." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قبلوا لوحتك، لكنهم لم يشاركوا لوحتهم بعد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie haben dein Board akzeptiert, aber noch nicht ihres geteilt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aceptaron tu tablero, pero aún no han compartido el suyo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ils ont accepté votre tableau, mais n'ont pas encore partagé le leur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanno accettato il tuo tabellone, ma non hanno ancora condiviso il loro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "彼らはあなたのボードを受け入れましたが、まだ自分のボードを共有していません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그들이 당신의 보드를 수락했지만 아직 자신의 보드를 공유하지 않았습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaakceptowali twoją tablicę, ale jeszcze nie udostępnili swojej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eles aceitaram seu quadro, mas ainda não compartilharam o deles."
          }
        }
      }
    },
    "They shared with you, but you haven't accepted yet." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شاركوا معك، لكنك لم تقبل بعد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie haben mit dir geteilt, aber du hast noch nicht akzeptiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compartieron contigo, pero aún no has aceptado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ils ont partagé avec vous, mais vous n'avez pas encore accepté."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanno condiviso con te, ma non hai ancora accettato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "彼らはあなたと共有しましたが、あなたはまだ受け入れていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그들이 당신과 공유했지만 아직 수락하지 않았습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udostępnili tobie, ale jeszcze nie zaakceptowałeś."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eles compartilharam com você, mas você ainda não aceitou."
          }
        }
      }
    },
    "Waiting for them to accept your invitation." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في انتظار قبول دعوتك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warten darauf, dass sie deine Einladung annehmen."
