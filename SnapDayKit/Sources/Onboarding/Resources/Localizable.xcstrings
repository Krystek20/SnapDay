            "state": "translated",
            "value": "You decide where your data is stored."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tú decides dónde se almacenan tus datos."
          }
        },
        "fr": {
          "stringUnit": {
