    "Seamlessly manage your habits and goals with iCloud.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwalte nahtlos deine Gewohnheiten und Ziele mit iCloud."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Seamlessly manage your habits and goals with iCloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestiona sin problemas tus hábitos y objetivos con iCloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gérez vos habitudes et objectifs en toute simplicité avec iCloud."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerencie seus hábitos e objetivos perfeitamente com o iCloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestisci le tue abitudini e obiettivi senza problemi con iCloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudで習慣と目標をシームレスに管理。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدر عاداتك وأهدافك بسلاسة مع iCloud."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud로 습관과 목표를 원활하게 관리하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Łatwo zarządzaj swoimi nawykami i celami za pomocą iCloud."
          }
        }
      }
    },
    "Set goals, track your progress, and build consistent habits to achieve what matters most.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setze Ziele, verfolge deinen Fortschritt und baue beständige Gewohnheiten auf, um das zu erreichen, was am wichtigsten ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set goals, track your progress, and build consistent habits to achieve what matters most."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Establece metas, sigue tu progreso y construye hábitos consistentes para lograr lo que más importa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixez des objectifs, suivez vos progrès et construisez des habitudes cohérentes pour atteindre ce qui compte le plus."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina objetivos, acompanhe seu progresso e construa hábitos consistentes para alcançar o que mais importa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fissa obiettivi, traccia i tuoi progressi e costruisci abitudini coerenti per raggiungere ciò che conta di più."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目標を設定し、進捗を追跡し、最も重要なことを達成するために一貫した習慣を構築しましょう。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدد الأهداف، وتتبع تقدمك، وابن عادات متسقة لتحقيق ما يهم أكثر."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목표를 설정하고, 진행 상황을 추적하며, 가장 중요한 것을 달성하기 위해 일관된 습관을 구축하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustal cele, śledź postępy i buduj konsekwentne nawyki, aby osiągnąć to, co najważniejsze."
          }
        }
      }
    },
