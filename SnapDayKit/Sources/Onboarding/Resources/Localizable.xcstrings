    "Stay on top of your progress and reach your goals faster—enable notifications to get timely reminders and track your activities effortlessly!": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bleibe auf dem Laufenden mit deinem Fortschritt und erreiche deine Ziele schneller – aktiviere Benachrichtigungen, um rechtzeitige Erinnerungen zu erhalten und deine Aktivitäten mühelos zu verfolgen!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stay on top of your progress and reach your goals faster—enable notifications to get timely reminders and track your activities effortlessly!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantente al tanto de tu progreso y alcanza tus metas más rápido: ¡activa las notificaciones para recibir recordatorios oportunos y seguir tus actividades sin esfuerzo!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restez au courant de vos progrès et atteignez vos objectifs plus rapidement – activez les notifications pour recevoir des rappels opportuns et suivre vos activités sans effort !"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha-se atualizado sobre seu progresso e alcance seus objetivos mais rapidamente – ative as notificações para receber lembretes oportunos e acompanhar suas atividades sem esforço!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimani aggiornato sui tuoi progressi e raggiungi i tuoi obiettivi più velocemente – attiva le notifiche per ricevere promemoria tempestivi e tracciare le tue attività senza sforzo!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "進捗を把握し、目標をより早く達成しましょう – 通知を有効にして適切なリマインダーを受け取り、活動を簡単に追跡しましょう！"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابق على اطلاع بتقدمك ووصل إلى أهدافك بشكل أسرع – فعّل الإشعارات للحصول على تذكيرات في الوقت المناسب ومتابعة أنشطتك بسهولة!"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진행 상황을 파악하고 목표를 더 빨리 달성하세요 – 알림을 활성화하여 적절한 알림을 받고 활동을 쉽게 추적하세요!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bądź na bieżąco ze swoimi postępami i osiągaj cele szybciej – włącz powiadomienia, aby otrzymywać przypomnienia i łatwo śledzić swoje działania!"
          }
        }
      }
    },
