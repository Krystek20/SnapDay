    "No one else, not even us, can access your data.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Niemand sonst, nicht einmal wir, können auf deine Daten zugreifen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No one else, not even us, can access your data."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadie más, ni siquiera nosotros, puede acceder a tus datos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Personne d'autre, pas même nous, ne peut accéder à vos données."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguém mais, nem mesmo nós, pode acessar seus dados."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun altro, nemmeno noi, può accedere ai tuoi dati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他の誰も、私たちでさえも、あなたのデータにアクセスできません。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن لأحد آخر، ولا حتى نحن، الوصول إلى بياناتك."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 누구도, 심지어 우리도 당신의 데이터에 접근할 수 없습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nikt inny, nawet my, nie ma dostępu do Twoich danych."
          }
        }
      }
    },
