    "Your activity data stays on your device": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Aktivitätsdaten bleiben auf deinem Gerät"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your activity data stays on your device"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus datos de actividad se quedan en tu dispositivo"
          }
