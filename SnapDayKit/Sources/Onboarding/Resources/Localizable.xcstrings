    "If using iCloud, only you can access your information.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du iCloud verwendest, kannst nur du auf deine Informationen zugreifen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If using iCloud, only you can access your information."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si utilizas iCloud, solo tú puedes acceder a tu información."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous utilisez iCloud, seul vous pouvez accéder à vos informations."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você usar o iCloud, apenas você pode acessar suas informações."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usi iCloud, solo tu puoi accedere alle tue informazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudを使用している場合、あなただけが情報にアクセスできます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا كنت تستخدم iCloud، يمكنك فقط الوصول إلى معلوماتك."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud를 사용하는 경우, 오직 당신만 정보에 접근할 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli korzystasz z iCloud, tylko Ty masz dostęp do swoich informacji."
          }
        }
      }
    },
