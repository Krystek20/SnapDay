    },
    "Build Better Habits, One Step at a Time": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Baue bessere Gewohnheiten, Schritt für Schritt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build Better Habits, One Step at a Time"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea mejores hábitos, un paso a la vez"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Construisez de meilleures habitudes, étape par étape"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Construa melhores hábitos, passo a passo"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Costruisci abitudini migliori, un passo alla volta"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "より良い習慣を一歩ずつ構築"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابن عادات أفضل، خطوة بخطوة"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 나은 습관을 한 걸음씩 구축"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Buduj lepsze nawyki, krok po kroku"
          }
        }
      }
    },
