    "e.g. add gym on Monday evening, set reminder 10 minutes before...": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مثال: أضف التمرين في النادي مساء الاثنين، واضبط تذكيرًا قبل 10 دقائق..."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "z. B. Fitnessstudio am Montagabend hinzufügen, Erinnerung 10 Minuten vorher einstellen ..."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "p. ej., añade gimnasio el lunes por la tarde y configura un recordatorio 10 minutos antes..."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "p. ex., ajoutez la salle de sport lundi soir et définissez un rappel 10 minutes avant…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "ad es. aggiungi palestra lunedì sera, imposta un promemoria 10 minuti prima..."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "例：月曜の夜にジムを追加し、10分前にリマインダーを設定…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예: 월요일 저녁에 헬스장 추가, 10분 전 알림 설정..."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "np. dodaj siłownię w poniedziałek wieczorem, ustaw przypomnienie 10 minut wcześniej…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "ex.: adicione academia na segunda-feira à noite e defina um lembrete 10 minutos antes..."
          }
        }
      }
    },
