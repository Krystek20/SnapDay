    "Total Time Spent on Tracked Activities": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesamtzeit für verfolgte Aktivitäten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Total Time Spent on Tracked Activities"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiempo total dedicado a las actividades rastreadas"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Łączny czas spędzony na śledzonych aktywnościach"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temps total passé sur les activités suivies"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempo total gasto em atividades rastreadas"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempo totale trascorso su attività tracciate"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追跡された活動に費やした総時間"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إجمالي الوقت المنقضي على الأنشطة المتعقبة"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추적된 활동에 소요된 총 시간"
          }
        }
      }
    },
    "Tracking time spent on completed activities versus total planned time helps you assess productivity, identify time management gaps, and improve future planning accuracy.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Nachverfolgen der Zeit für erledigte Aktivitäten im Vergleich zur geplanten Gesamtzeit hilft, die Produktivität zu bewerten, Lücken im Zeitmanagement zu identifizieren und die Genauigkeit der zukünftigen Planung zu verbessern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tracking time spent on completed activities versus total planned time helps you assess productivity, identify time management gaps, and improve future planning accuracy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rastrear el tiempo invertido en actividades completadas versus el tiempo total planificado ayuda a evaluar la productividad, identificar brechas en la gestión del tiempo y mejorar la precisión en la planificación futura."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Śledzenie czasu spędzonego na wykonanych zadaniach w porównaniu z planowanym czasem pomaga ocenić produktywność, zidentyfikować luki w zarządzaniu czasem i poprawić dokładność przyszłego planowania."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivre le temps consacré aux activités terminées par rapport au temps total prévu vous aide à évaluer la productivité, à identifier les lacunes en gestion du temps et à améliorer la précision de la planification future."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Rastrear o tempo gasto em atividades concluídas versus o tempo total planejado ajuda você a avaliar a produtividade, identificar lacunas na gestão do tempo e melhorar a precisão do planejamento futuro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitorare il tempo impiegato nelle attività completate rispetto al tempo totale programmato ti aiuta a valutare la produttività, identificare le lacune nella gestione del tempo e migliorare l'accuratezza della pianificazione futura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了した活動に費やした時間と総計画時間を追跡することで、生産性を評価し、時間管理のギャップを特定し、将来の計画精度を改善できます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تساعدك تتبع الوقت المستغرق في الأنشطة المنجزة مقابل الوقت المخطط الإجمالي على تقييم الإنتاجية، وتحديد الفجوات في إدارة الوقت، وتحسين دقة التخطيط المستقبلي."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료된 활동에 소요된 시간과 총 계획 시간을 추적하면 생산성을 평가하고 시간 관리의 격차를 식별하며 향후 계획의 정확성을 개선하는 데 도움이 됩니다."
          }
        }
      }
    },
